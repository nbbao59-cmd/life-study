# ==========================================
# LIFE & STUDY DASHBOARD - CẤU HÌNH MÔI TRƯỜNG
# ==========================================

# Khóa API Gemini từ Google AI Studio (Bắt buộc để dùng Trợ lý AI)
# Lấy key miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Cấu hình AI Model (gemini-3.5-flash ổn định, tốc độ cao)
GEMINI_MODEL=gemini-3.5-flash
GEMINI_THINKING_LEVEL=low

# Cấu hình Backend Server (Proxy bảo mật API Key)
PORT=8787
HOST=127.0.0.1
ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=20
